<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. install.sh substitutes the @@...@@ placeholders and writes the result to
     ~/Library/LaunchAgents/local.keynote-render.plist. Do not install this file directly. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.keynote-render</string>
  <key>ProgramArguments</key>
  <array>
    <string>@@PYTHON@@</string>
    <string>@@APP@@/render_queue.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONDONTWRITEBYTECODE</key><string>1</string>
    <key>KR_ALLOWED_ROOT</key><string>@@DECK_ROOT@@</string>
    <key>KR_ROOT</key><string>@@KR_ROOT@@</string>
  </dict>
  <key>WatchPaths</key>
  <array><string>@@KR_ROOT@@/requests</string></array>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>@@LOG@@</string>
  <key>StandardErrorPath</key><string>@@LOG@@</string>
</dict>
</plist>
